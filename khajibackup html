<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <link rel="icon" type="image/png" href="Khaji.png">
    <title>Khaji Chat</title>
    
    <!-- Firebase SDK -->
    <script src="https://www.gstatic.com/firebasejs/9.6.1/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.6.1/firebase-auth-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.6.1/firebase-database-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.6.1/firebase-storage-compat.js"></script>
    
    <!-- Styles -->
    <link rel="stylesheet" href="css/style.css">
</head>
<body>
    <!-- Audio Elements -->
    <audio id="msgSound" src="https://cdn.freesound.org/previews/320/320655_5260872-lq.mp3" preload="auto"></audio>
    <audio id="sentSound" src="https://cdn.freesound.org/previews/411/411411_5121236-lq.mp3" preload="auto"></audio>
    <audio id="ringSound" src="Test Ringtone.mp3" preload="auto" loop></audio>

    <!-- Toast Container -->
    <div class="toast-container" id="toastContainer"></div>

    <!-- Main Container -->
    <div class="container">
        <!-- Auth Section -->
        <div class="auth-section" id="authSection">
            <img src="Khaji.png" class="auth-logo" alt="Logo" onerror="this.style.display='none'">
            <h1>Khaji Chat</h1>
            <div class="auth-form">
                <div id="authMainContainer">
                    <div class="auth-tabs" id="authTabs">
                        <button class="auth-tab active" onclick="switchAuthTab('login')">Login</button>
                        <button class="auth-tab" onclick="switchAuthTab('register')">Register</button>
                    </div>
                    
                    <!-- Login Form -->
                    <div id="loginForm">
                        <div class="input-group">
                            <input type="email" id="loginEmail" placeholder="Email" autocapitalize="off">
                        </div>
                        <div class="input-group">
                            <input type="password" id="loginPass" placeholder="Password">
                        </div>
                        <button class="auth-btn" id="loginBtn" onclick="login()">Login</button>
                        <span class="link-text" onclick="showForgotPassword()">Forgot Password?</span>
                    </div>
                    
                    <!-- Register Form -->
                    <div id="registerForm" style="display:none;">
                        <div class="input-group">
                            <input type="text" id="regName" placeholder="Full Name" autocapitalize="words">
                        </div>
                        <div class="input-group">
                            <input type="email" id="regEmail" placeholder="Email" autocapitalize="off">
                        </div>
                        <div class="input-group">
                            <input type="password" id="regPass" placeholder="Password">
                        </div>
                        <button class="auth-btn" id="regBtn" onclick="register()">Register</button>
                    </div>
                </div>

                <!-- Forgot Password Container -->
                <div id="forgotContainer" style="display:none;">
                    <h3 class="modal-title">Reset Password</h3>
                    <p class="info-text">Enter your email to receive a reset link.</p>
                    <div class="input-group">
                        <input type="email" id="forgotEmail" placeholder="Email" autocapitalize="off">
                    </div>
                    <button class="auth-btn" onclick="resetPassword()">Send Link</button>
                    <span class="link-text" onclick="backToLogin()">Back to Login</span>
                </div>

                <!-- Email Verification Container -->
                <div id="verifyContainer" style="display:none;">
                    <h3 class="modal-title">Please verify your email.The email must be drop on your Spam Mail as well.</h3>
                    <p class="info-text">A verification link has been sent to:</p>
                    <p class="email-label" id="verifyEmailLabel"></p>
                    <button class="auth-btn" onclick="resendVerification()">Resend Email</button>
                    <button class="auth-btn secondary" onclick="checkVerification()">I have verified / Refresh</button>
                    <span class="link-text" onclick="logout()">Logout</span>
                </div>
            </div>
        </div>

        <!-- App Section -->
        <div class="app-section" id="appSection">
            <div class="app-container" id="appContainer">
                <!-- Sidebar -->
                <div class="sidebar">
                    <div class="user-profile" onclick="openModal('profileModal')">
                        <div class="avatar" id="myAvatar">U</div>
                        <div class="user-info">
                            <h3 id="myName">User</h3>
                            <div class="status-toggle">
                                <input type="checkbox" id="onlineCheck" checked onchange="toggleStatus()" onclick="event.stopPropagation()">
                                <label for="onlineCheck">Online</label>
                            </div>
                        </div>
                        <div class="settings-icon">⚙️</div>
                    </div>
                    
                    <!-- Tabs -->
                    <div class="tabs">
                        <div class="tab active" onclick="loadTab('chats')" id="tabChats">Chats</div>
                        <div class="tab" onclick="loadTab('friends')" id="tabFriends">Friends</div>
                        <div class="tab" onclick="loadTab('groups')" id="tabGroups">Groups</div>
                        <div class="tab" onclick="loadTab('search')" id="tabSearch">Search</div>
                    </div>
                    
                    <!-- Sidebar Content -->
                    <div class="tab-content" id="sidebarContent"></div>
                </div>

                <!-- Main Chat Area -->
                <div class="main-content">
                    <!-- Chat Header -->
                    <div class="chat-header">
                        <button class="back-btn" onclick="goBack()">⬅️</button>
                        <div class="chat-user-info" onclick="openChatInfo()">
                            <div class="avatar" id="chatAvatar">?</div>
                            <div class="chat-user-details">
                                <h3 id="chatName">Select Chat</h3>
                                <div class="typing-indicator" id="typingDiv">typing...</div>
                            </div>
                        </div>
                        <div class="call-btns">
                            <button class="icon-btn" id="videoCallBtn" onclick="startCall('video')" disabled>
                                <svg viewBox="0 0 24 24"><path d="M17 10.5V7c0-.55-.45-1-1-1H4c-.55 0-1 .45-1 1v10c0 .55.45 1 1 1h12c.55 0 1-.45 1-1v-3.5l4 4v-11l-4 4z"/></svg>
                            </button>
                            <button class="icon-btn" id="audioCallBtn" onclick="startCall('audio')" disabled>
                                <svg viewBox="0 0 24 24"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
                            </button>
                        </div>
                    </div>
                    
                    <!-- Messages Container -->
                    <div class="chat-messages" id="msgBox">
                        <div class="empty-state">Select a chat to start</div>
                    </div>
                    
                    <!-- Chat Input Area -->
                    <div class="chat-input-area">
                        <input type="file" id="imageInput" accept="image/*" onchange="handleImageUpload(event)">
                        <button class="img-btn" onclick="document.getElementById('imageInput').click()">📷</button>
                        <input type="text" class="chat-input" id="msgInput" placeholder="Message..." oninput="handleTyping()" onkeypress="if(event.key==='Enter')sendMessage()">
                        <button class="send-btn" id="sendBtn" onclick="sendMessage()" disabled>Send</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modals -->
    
    <!-- Profile Modal -->
    <div class="modal-overlay" id="profileModal">
        <div class="modal-content">
            <button class="modal-close" onclick="closeModal('profileModal')">&times;</button>
            <h2 class="modal-title">Settings & Profile</h2>
            <input type="text" class="modal-input" id="editName" placeholder="Name">
            <input type="text" class="modal-input" id="editBio" placeholder="Bio">
            <input type="text" class="modal-input" id="editStatus" placeholder="Status (e.g., Busy)">
            <button class="modal-save-btn" onclick="saveProfile()">Save Profile</button>
            <hr class="divider">
            <button class="modal-save-btn logout-btn" onclick="logout()">Logout</button>
        </div>
    </div>

    <!-- Friend Detail Modal -->
    <div class="modal-overlay" id="friendModal">
        <div class="modal-content">
            <button class="modal-close" onclick="closeModal('friendModal')">&times;</button>
            <div class="friend-detail-header">
                <div class="avatar large" id="friendDetailAvatar">U</div>
                <div>
                    <h2 id="friendDetailName">Friend</h2>
                    <p id="friendDetailStatus" class="friend-status">Status</p>
                </div>
            </div>
            <p class="detail-item"><strong>Bio:</strong> <span id="friendDetailBio">-</span></p>
            <p class="detail-item"><strong>Last Seen:</strong> <span id="friendDetailLastSeen">-</span></p>
        </div>
    </div>

    <!-- Create Group Modal -->
    <div class="modal-overlay" id="groupModal">
        <div class="modal-content">
            <button class="modal-close" onclick="closeModal('groupModal')">&times;</button>
            <h2 class="modal-title">Create Group</h2>
            <input type="text" class="modal-input" id="groupName" placeholder="Group Name">
            <div class="member-list" id="memberList"></div>
            <button class="modal-save-btn" onclick="createGroup()">Create Group</button>
        </div>
    </div>

    <!-- Group Info Modal -->
    <div class="modal-overlay" id="groupInfoModal">
        <div class="modal-content">
            <button class="modal-close" onclick="closeModal('groupInfoModal')">&times;</button>
            <h2 class="modal-title" id="groupInfoName"></h2>
            <p class="group-info-members" id="groupInfoMembers"></p>
            <hr class="divider">
            <button class="modal-save-btn leave-btn" onclick="leaveGroup()">Leave Group</button>
        </div>
    </div>

    <!-- Delete Message Modal -->
    <div class="modal-overlay" id="deleteModal">
        <div class="modal-content small">
            <h3 class="modal-title">Delete Message?</h3>
            <p class="warning-text">This cannot be undone.</p>
            <div class="button-group">
                <button class="secondary-btn" onclick="closeModal('deleteModal')">Cancel</button>
                <button class="danger-btn" onclick="confirmDelete()">Delete</button>
            </div>
        </div>
    </div>

    <!-- Image Preview Modal -->
    <div class="modal-overlay" id="imagePreviewModal" onclick="closeModal('imagePreviewModal')">
        <img id="previewImg" class="preview-image">
    </div>

    <!-- Video Call Modal -->
    <div class="video-modal" id="callModal">
        <div class="video-grid">
            <div id="callStatusOverlay" class="call-status-overlay">
                <h2 id="overlayTitle">Calling...</h2>
                <p id="overlayStatus">Ringing</p>
            </div>

            <div class="video-box" id="remoteVideoBox">
                <video id="remoteVid" autoplay playsinline></video>
                <div class="video-label" id="remoteLabel">Friend</div>
            </div>
            
            <div class="video-box local-pip" id="localVideoBox">
                <video id="localVid" autoplay muted playsinline></video>
            </div>
        </div>
        
        <div class="call-controls">
            <button class="control-btn" id="micBtn" onclick="toggleMic()">🎤</button>
            <button class="control-btn" id="camBtn" onclick="toggleCam()">📹</button>
            <button class="control-btn" id="switchCamBtn" onclick="switchCamera()">🔄</button>
            <button class="control-btn end" onclick="endCall(false)">📞</button>
        </div>
    </div>

    <!-- Incoming Call Modal -->
    <div class="modal-overlay" id="incomingModal">
        <div class="modal-content incoming-call-ui">
            <h2 id="callerName">Caller</h2>
            <p id="callTypeText">Incoming Call...</p>
            <div class="call-actions">
                <button class="decline-btn" onclick="rejectCall()">Reject</button>
                <button class="answer-btn" onclick="answerCall()">Answer</button>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="js/script.js"></script>
</body>
</html>
